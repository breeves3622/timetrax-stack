# ==========================================
# TimeTrex Community Edition Environment Setup
# ==========================================

# Port Configuration
TIMETREX_PORT=8090
NTFY_PORT=8080
BRIDGE_PORT=5000

# PostgreSQL Database Configuration
POSTGRES_USER=timetrex
POSTGRES_PASSWORD=timetrexpass
POSTGRES_DB=timetrex

# ntfy Push Server Settings
NTFY_SERVER_URL=http://ntfy:8080
NTFY_TOPIC=timetrax-alerts
NTFY_AUTH_TOKEN=
NTFY_BASE_URL=http://localhost:8080

# System Directories & Timezone
TZ=America/New_York
DATA_DIR=/opt/timetrax
NTFY_DATA_DIR=/opt/timetrax/ntfy
