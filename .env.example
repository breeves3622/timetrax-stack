# ==========================================
# TimeTrax Host Environment Configuration
# ==========================================

# Port Configuration
TIMETRAX_PORT=3000
NTFY_PORT=8080

# ntfy Push Server Settings
# For internal docker network communication: http://ntfy:8080
# For external/public ntfy server: https://ntfy.sh
NTFY_SERVER_URL=http://ntfy:8080
NTFY_TOPIC=timetrax-alerts
NTFY_AUTH_TOKEN=
NTFY_BASE_URL=http://localhost:8080

# System Settings
TZ=America/New_York
DATA_DIR=/opt/timetrax/data
NTFY_DATA_DIR=/opt/timetrax/ntfy
