# ==========================================
# TorBox + Jellyfin Media Stack Configuration
# ==========================================

# TorBox Debrid API Key (From https://torbox.app/settings)
TORBOX_API_KEY=your_torbox_api_key_here

# General System Settings
TZ=America/New_York
PUID=1000
PGID=1000
SERVER_IP=192.168.1.100

# Path Configurations (Must match host directory setup)
DATA_DIR=/opt/torbox-stack
MEDIA_DIR=/mnt/torbox/media

# Database Password
POSTGRES_PASSWORD=riven_secure_password_123

# Service Ports
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055
RIVEN_PORT=8080
